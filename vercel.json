{
  "framework": "nextjs",
  "buildCommand": "bun run build",
  "installCommand": "bun install",
  "functions": {
    "src/app/api/analyze/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/meals/route.ts": {
      "maxDuration": 10
    },
    "src/app/api/cron/channel-summary/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/slack-bot/route.ts": {
      "maxDuration": 15
    },
    "src/app/api/cron/weekly-recap/route.ts": {
      "maxDuration": 120
    },
    "src/app/api/cron/weekly-snapshot/route.ts": {
      "maxDuration": 120
    }
  },
  "crons": [
    {
      "path": "/api/cron/channel-summary",
      "schedule": "0 13 * * 5"
    },
    {
      "path": "/api/cron/channel-summary",
      "schedule": "0 7 * * 1"
    },
    {
      "path": "/api/cron/channel-summary",
      "schedule": "0 17 * * 2,3"
    },
    {
      "path": "/api/cron/weekly-recap",
      "schedule": "0 17 * * 0"
    },
    {
      "path": "/api/cron/weekly-snapshot",
      "schedule": "5 22 * * 0"
    },
    {
      "path": "/api/cron/battle-reminder",
      "schedule": "0 8 * * *"
    }
  ]
}
